$on = New-Object -ComObject OneNote.Application
[xml]$hier = ''
$on.GetHierarchy('', 3, [ref]$hier)
$targetSection = $null
foreach ($nb in $hier.Notebooks.Notebook) {
    foreach ($sec in $nb.Section) {
        if ($sec.name -like '*Quick Notes*') { $targetSection = $sec; break }
    }
    if ($targetSection) { break }
}
if (-not $targetSection) { $targetSection = $hier.Notebooks.Notebook.Section | Select-Object -First 1 }
$sectionId = $targetSection.ID
$newPageId = ''
$on.CreateNewPage($sectionId, [ref]$newPageId, 1)
Start-Sleep -Milliseconds 2000
[xml]$pageXml = ''
$on.GetPageContent($newPageId, [ref]$pageXml, 7)
$pageId = $pageXml.Page.ID
$ns = 'xmlns:one="http://schemas.microsoft.com/office/onenote/2013/onenote"'
$xml  = '<?xml version="1.0" encoding="utf-8"?>'
$xml += '<one:Page ' + $ns + ' ID="' + $pageId + '">'
$xml += '<one:Title><one:OE><one:T><![CDATA[Note Title]] ></one:T></one:OE></one:Title>'
$xml += '<one:Outline>'
$xml += '<one:Position x="36" y="86" />'
$xml += '<one:Size width="600" height="200" />'
$xml += '<one:OEChildren>'
$xml += '<one:OE><one:T><![CDATA[First paragraph here.]] ></one:T></one:OE>'
$xml += '<one:OE spaceBefore="4" spaceAfter="4"><one:List><one:Bullet>•</one:Bullet></one:List><one:T><![CDATA[Bullet point]] ></one:T></one:OE>'
$xml += '<one:OE><one:Tag index="0" completed="false" /><one:T><![CDATA[Checklist item]] ></one:T></one:OE>'
$xml += '</one:OEChildren>'
$xml += '</one:Outline>'
$xml += '</one:Page>'
$on.UpdatePageContent($xml, [System.DateTime]:MinValue, 1, $false)
Start-Sleep - Milliseconds 1000
Try { $On.NavigateTo($newPageId, '', $false) } catch {}
Write-Output('Note created in section: ' + $targetSection.name)

