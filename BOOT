====================================================
MICROSOFT ACCESS — COM + ADODB AUTOMATION
====================================================

Access automation uses BOTH COM (Access.Application) and ADODB as fallback.
ALWAYS try COM first. If Access is not installed, fall back to ADODB via ACE driver.

ACCESS COM RULES:
- ALWAYS try COM first: $access = New-Object -ComObject Access.Application
- IF COM fails, use ADODB: $conn = New-Object -ComObject ADODB.Connection
- ADODB connection string: 'Provider=Microsoft.ACE.OLEDB.12.0;Data Source=C:\path\to\db.accdb'
- NEVER use SendKeys to interact with Access — ALWAYS use COM or ADODB
- NEVER call $access.Quit() — leave Access open so the user can see it
- ALWAYS set $access.Visible = $true when using COM
- ALWAYS set $access.UserControl = $true so Access does not close when script ends
- For new databases: $access.NewCurrentDatabase($dbPath)
- For existing databases: $access.OpenCurrentDatabase($dbPath)

ACCESS DETECT + FALLBACK PATTERN — use this every time:
$access = $null
$useADODB = $false
try {
    $access = New-Object -ComObject Access.Application
    $access.Visible = $true
} catch {
    Write-Output ('Access COM unavailable, using ADODB: ' + $_.Exception.Message)
    $useADODB = $true
}
if (-not $useADODB) {
    # Use $access COM object
} else {
    # Use ADODB fallback
}

CREATE DATABASE + TABLE (COM):
$access = New-Object -ComObject Access.Application
$access.Visible = $true
$access.NewCurrentDatabase('C:\Users\User\Documents\MyDatabase.accdb')
$db = $access.CurrentDb()
$tbl = $db.CreateTableDef('Contacts')
$tbl.Fields.Append($tbl.CreateField('ID', 4))
$tbl.Fields.Item('ID').Attributes = 17
$tbl.Fields.Append($tbl.CreateField('Name', 10, 255))
$tbl.Fields.Append($tbl.CreateField('Email', 10, 255))
$tbl.Fields.Append($tbl.CreateField('Phone', 10, 50))
$db.TableDefs.Append($tbl)
$access.UserControl = $true
Write-Output 'Database and table created.'

CREATE DATABASE + TABLE (ADODB fallback):
$dbPath = 'C:\Users\User\Documents\MyDatabase.accdb'
$cat = New-Object -ComObject ADOX.Catalog
$cat.Create('Provider=Microsoft.ACE.OLEDB.12.0;Data Source=' + $dbPath)
$conn = New-Object -ComObject ADODB.Connection
$conn.Open('Provider=Microsoft.ACE.OLEDB.12.0;Data Source=' + $dbPath)
$cmd = New-Object -ComObject ADODB.Command
$cmd.ActiveConnection = $conn
$cmd.CommandText = 'CREATE TABLE [Contacts] (ID AUTOINCREMENT PRIMARY KEY, [Name] TEXT(255), [Email] TEXT(255), [Phone] TEXT(50))'
$cmd.Execute() | Out-Null
$conn.Close()
Start-Process $dbPath
Write-Output 'Database created via ADODB.'

QUERY DATABASE:
$conn = New-Object -ComObject ADODB.Connection
$conn.Open('Provider=Microsoft.ACE.OLEDB.12.0;Data Source=C:\path\to\db.accdb')
$rs = New-Object -ComObject ADODB.Recordset
$rs.Open('SELECT * FROM [TableName]', $conn)
$output = ''
$headers = @()
for ($f = 0; $f -lt $rs.Fields.Count; $f++) { $headers += $rs.Fields.Item($f).Name }
$output += ($headers -join ' | ') + [char]13 + [char]10
$output += ('-' * 60) + [char]13 + [char]10
while (-not $rs.EOF) {
    $row = @()
    for ($f = 0; $f -lt $rs.Fields.Count; $f++) { $row += [string]$rs.Fields.Item($f).Value }
    $output += ($row -join ' | ') + [char]13 + [char]10
    $rs.MoveNext()
}
$rs.Close()
$conn.Close()
Write-Output $output

IMPORT CSV INTO ACCESS TABLE:
$dbPath = 'C:\path\to\db.accdb'
$csvPath = 'C:\path\to\data.csv'
$tableName = 'ImportedData'
$conn = New-Object -ComObject ADODB.Connection
$conn.Open('Provider=Microsoft.ACE.OLEDB.12.0;Data Source=' + $dbPath)
$csvLines = [System.IO.File]::ReadAllLines($csvPath)
$headers = $csvLines[0].Split(',') | ForEach-Object { $_.Trim().Trim('"') }
$cmd = New-Object -ComObject ADODB.Command
$cmd.ActiveConnection = $conn
for ($i = 1; $i -lt $csvLines.Length; $i++) {
    $vals = $csvLines[$i].Split(',') | ForEach-Object { $_.Trim().Trim('"').Replace("'","''") }
    $cols = ($headers | ForEach-Object { '[' + $_ + ']' }) -join ', '
    $vstr = ($vals | ForEach-Object { "'" + $_ + "'" }) -join ', '
    $cmd.CommandText = "INSERT INTO [$tableName] ($cols) VALUES ($vstr)"
    try { $cmd.Execute() | Out-Null } catch {}
}
$conn.Close()
Write-Output 'CSV imported successfully.'

EXPORT ACCESS TABLE TO EXCEL:
$dbPath = 'C:\path\to\db.accdb'
$exportPath = 'C:\Users\User\Documents\AccessExport.xlsx'
$conn = New-Object -ComObject ADODB.Connection
$conn.Open('Provider=Microsoft.ACE.OLEDB.12.0;Data Source=' + $dbPath)
$rs = New-Object -ComObject ADODB.Recordset
$rs.Open('SELECT * FROM [TableName]', $conn)
$excel = New-Object -ComObject Excel.Application
$excel.Visible = $false
$wb = $excel.Workbooks.Add()
$ws = $wb.Worksheets.Item(1)
for ($f = 0; $f -lt $rs.Fields.Count; $f++) {
    $ws.Cells.Item(1, $f + 1).Value = $rs.Fields.Item($f).Name
    $ws.Cells.Item(1, $f + 1).Font.Bold = $true
}
$row = 2
while (-not $rs.EOF) {
    for ($f = 0; $f -lt $rs.Fields.Count; $f++) {
        $ws.Cells.Item($row, $f + 1).Value = [string]$rs.Fields.Item($f).Value
    }
    $rs.MoveNext()
    $row++
}
$ws.UsedRange.Columns.AutoFit() | Out-Null
$rs.Close()
$conn.Close()
$wb.SaveAs($exportPath)
$wb.Close($false)
$excel.Quit()
Write-Output ('Exported to: ' + $exportPath)

ACCESS FIELD TYPE CONSTANTS:
- 1  = Boolean (Yes/No)
- 4  = Long Integer (use for ID with AutoIncrement Attributes=17)
- 5  = Currency
- 7  = Double
- 8  = Date/Time
- 10 = Text (max 255 chars, specify length as 3rd param)
- 12 = Memo (long text)

